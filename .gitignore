# Local .terraform directories (contains provider plugins and modules)
**/.terraform/*

# .tfstate files (Contains sensitive infrastructure data and secrets!)
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files (Where you typically store passwords/secrets)
*.tfvars
*.tfvars.json

# Ignore override files as they are meant for local testing
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore public and private key files
*.pub
*.pem
terra-key-ec2